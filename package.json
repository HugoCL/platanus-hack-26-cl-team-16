{
  "name": "hackathon-toolbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo:agent": "node scripts/demo-agent.mjs",
    "dev:cloud": "convex dev --start 'next dev'",
    "seed": "convex run seed:ensure",
    "seed:reset": "convex run seed:reset",
    "migrate": "convex run migrations:runAll",
    "mcp:key": "convex run agentKeys:issue",
    "mcp:revoke": "convex run agentKeys:revoke",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "pnpm typecheck && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "skills:sync": "node scripts/skills/sync.mjs",
    "skills:check": "node scripts/skills/check.mjs",
    "skills:link": "node scripts/skills/link.mjs",
    "smoke": "python3 scripts/smoke.py",
    "browser:install": "agent-browser install",
    "test": "vitest run",
    "eval:moderator": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.9",
    "@convex-dev/migrations": "0.3.8",
    "@convex-dev/rate-limiter": "0.4.3",
    "@convex-dev/workpool": "0.4.16",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "ai": "7.0.176",
    "convex": "1.50.0",
    "convex-helpers": "0.1.135",
    "lucide-react": "1.75.0",
    "next": "^16.3.0",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@edge-runtime/vm": "5.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "agent-browser": "0.43.0",
    "convex-test": "0.0.72",
    "skills": "1.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
